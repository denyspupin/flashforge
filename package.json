{
  "name": "flashforge",
  "version": "0.1.0",
  "private": true,
  "description": "A vocabulary learning platform with flashcard decks, study sessions, and gamification (XP, streaks).",
  "license": "MIT",
  "homepage": "https://flashforge.denyspupin.dev",
  "repository": {
    "type": "git",
    "url": "https://github.com/denyspupin/flashforge.git"
  },
  "bugs": {
    "url": "https://github.com/denyspupin/flashforge/issues"
  },
  "engines": {
    "node": ">=20.18.0"
  },
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs generate",
    "db:push": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs push",
    "db:migrate": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs migrate",
    "db:migrate:test": "node --env-file=tests/.env.test node_modules/drizzle-kit/bin.cjs migrate",
    "db:studio": "node --env-file=.env.local node_modules/drizzle-kit/bin.cjs studio",
    "db:seed": "node --env-file=.env.local --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed.ts",
    "db:seed:mock": "node --env-file=.env.local --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-mock.ts",
    "db:seed:mock:reset": "node --env-file=.env.local --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-mock.ts --reset",
    "db:seed:prompts": "node --env-file=.env.local --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-prompts.ts",
    "db:seed:long-text": "node --env-file=.env.local --experimental-strip-types --disable-warning=ExperimentalWarning --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/seed-long-text.ts",
    "test": "node --env-file=tests/.env.test node_modules/vitest/vitest.mjs run",
    "test:watch": "node --env-file=tests/.env.test node_modules/vitest/vitest.mjs",
    "test:unit": "node --env-file=tests/.env.test node_modules/vitest/vitest.mjs run tests/unit",
    "test:integration": "node --env-file=tests/.env.test node_modules/vitest/vitest.mjs run tests/integration",
    "test:coverage": "node --env-file=tests/.env.test node_modules/vitest/vitest.mjs run --coverage"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@clerk/nextjs": "^7.9.17",
    "@hookform/resolvers": "5.9.2",
    "@neondatabase/serverless": "^1.2.0",
    "@radix-ui/react-label": "2.1.17",
    "@radix-ui/react-slot": "1.5.0",
    "@tanstack/react-query": "5.104.3",
    "@tanstack/react-query-devtools": "5.104.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "drizzle-orm": "^0.45.4",
    "framer-motion": "12.40.0",
    "lru-cache": "^11.5.3",
    "lucide-react": "^1.59.0",
    "next": "^16.4.2",
    "pg": "8.23.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-hook-form": "7.90.0",
    "recharts": "^3.10.1",
    "svix": "^1.99.1",
    "tailwind-merge": "^3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "^4.6.7",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.12",
    "autoprefixer": "^10.6.1",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.4.2",
    "playwright": "^1.64.1",
    "postcss": "^8.5.30",
    "shadcn": "4.22.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^4.1.12"
  }
}
